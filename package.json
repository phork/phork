{
  "name": "@phork/phork",
  "description": "Phork",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/phork/phork.git"
  },
  "scripts": {
    "about-all": "node ./scripts/pkg-about-scripts.js",
    "about-build-deps": "echo '🗑️🧰 Remove the old generated files (icons and JSON) and build new ones' && exit 0",
    "about-build": "echo '🧰 Build the production site' && exit 0",
    "about-clean-build": "echo '🗑️📂 Remove the build dir' && exit 0",
    "about-clean-icons": "echo '🗑️📂 Create a fresh icon build dir' && exit 0",
    "about-deploy": "echo '🧰📦🌈 Build the site and rsync the files to the destination' && exit 0",
    "about-dev": "echo '🚀 Start the Vite development server' && exit 0",
    "about-eslint": "echo '🤖🖍️ Run eslint and fix the problems' && exit 0",
    "about-gen-icons": "echo '🧰 Generate React components from the SVG icons' && exit 0",
    "about-gen-json-vars": "echo '🧰 Create JSON config files out of the PostCSS vars' && exit 0",
    "about-prepare": "echo '🤖🖍️ Install the necessary dependencies' && exit 8",
    "about-prettier": "echo '🤖🖍️ Run prettier and fix the problems' && exit 0",
    "about-preview": "echo '🚀 Preview the production build locally' && exit 0",
    "about-stylelint": "echo '🤖🖍️ Run stylelint and fix the problems' && exit 0",
    "about-test-watch": "echo '🤖👁️‍🗨️ Run the Vitest tests and watch for changes' && exit 0",
    "about-test": "echo '🤖 Run the Vitest tests' && exit 0",
    "about-validate": "echo '🤖 Validates the files with eslint and stylelint' && exit 0",
    "about-watch": "echo '🤖👁️‍🗨️ Watch for typescript bugs' && exit 0",
    "build-deps": "npm-run-all --serial clean-icons gen-icons gen-json-vars",
    "build": "vite build",
    "clean-build": "rimraf build",
    "clean-icons": "rimraf src/icons && mkdirp src/icons",
    "deploy": "pnpm build-deps && pnpm build && pnpm deploy",
    "dev": "pnpm build-deps && vite",
    "eslint": "eslint \"{src,__tests__}/**/*.{js,json,ts,tsx,mdx}\" --fix",
    "gen-icons": "node ./scripts/generate-svg-icons.js",
    "gen-json-vars": "node ./scripts/generate-postcss-vars-json.js",
    "postinstall": "husky install",
    "pre-commit": "lint-staged",
    "prepare": "husky install",
    "prettier": "prettier \"./**/*.{js,json,ts,tsx}\" --write",
    "preview": "vite preview --port 8443",
    "start": "pnpm dev",
    "stylelint": "stylelint \"src/**/*.css\" --fix",
    "test": "vitest run",
    "test-watch": "vitest",
    "validate": "eslint \"src/**/*.{js,json,ts,tsx}\" && stylelint \"src/**/*.css\"",
    "watch": "tsc --watch --noEmit --project './tsconfig.json'"
  },
  "files": [
    "build/*"
  ],
  "sideEffects": [
    "*.css"
  ],
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,json,ts,tsx}": [
      "pnpm prettier",
      "pnpm eslint",
      "git add"
    ],
    "*.css": [
      "pnpm stylelint",
      "git add"
    ]
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.1.5",
    "@emotion/styled": "^11.3.0",
    "@phork/phorkit": "^14.0.2",
    "@welldone-software/why-did-you-render": "^6.1.1",
    "immer": "^9.0.6",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "react-helmet": "^6.1.0",
    "react-router": "^5.2.1",
    "react-router-dom": "^5.3.0",
    "uuid": "^8.3.0",
    "workbox-core": "^6.0.2",
    "workbox-expiration": "^6.0.2",
    "workbox-precaching": "^6.0.2",
    "workbox-routing": "^6.0.2",
    "workbox-strategies": "^6.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.13.16",
    "@babel/eslint-parser": "^7.13.10",
    "@babel/preset-env": "^7.13.10",
    "@babel/preset-react": "^7.12.13",
    "@babel/preset-typescript": "^7.13.0",
    "@commitlint/cli": "^13.2.1",
    "@commitlint/config-conventional": "^13.2.0",
    "@iarna/toml": "^2.2.5",
    "@svgr/core": "^5.5.0",
    "@svgr/plugin-jsx": "^5.5.0",
    "@svgr/plugin-prettier": "^5.5.0",
    "@svgr/plugin-svgo": "^5.5.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.5.0",
    "@trivago/prettier-plugin-sort-imports": "^2.0.1",
    "@types/node": "^14.14.37",
    "@types/react": "^17.0.3",
    "@types/react-dom": "^17.0.2",
    "@types/react-helmet": "^6.1.4",
    "@types/react-router": "^5.1.0",
    "@types/react-router-dom": "^5.3.2",
    "@types/theme-ui": "^0.6.0",
    "@types/uuid": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.2.5",
    "camelcase": "^6.2.0",
    "chalk": "^4.1.0",
    "commitlint-config-gitmoji": "^2.2.6",
    "concat-stream": "^2.0.0",
    "cssnano": "^5.0.1",
    "eslint-config-prettier": "^8.2.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-json": "^2.1.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.0.1",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-react-hooks": "^4.2.0",
    "envfile": "^6.14.0",
    "husky": "^7.0.4",
    "jsdom": "^25.0.0",
    "lint-staged": "^10.5.4",
    "mkdirp": "^1.0.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.2.10",
    "postcss-import": "^14.0.1",
    "postcss-mixins": "^7.0.3",
    "postcss-nested": "^5.0.5",
    "postcss-simple-vars": "^6.0.3",
    "prettier": "^2.0.4",
    "prettier-eslint": "^12.0.0",
    "rimraf": "^3.0.2",
    "stylelint": "^13.12.0",
    "stylelint-config-prettier": "^8.0.2",
    "stylelint-config-recommended": "^4.0.0",
    "ts-node": "^9.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "stylis": "^4.0.10"
    },
    "onlyBuiltDependencies": ["esbuild"]
  }
}
